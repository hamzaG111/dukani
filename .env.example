# ==============================================
# DUKANI — Environment Variables
# Copy this file to .env.local and fill in values
# ==============================================

# ─── AI (Anthropic) ───────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Auth ─────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-too

# ─── Supabase ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── WhatsApp (Meta Business API) ─────────────
# Get from: https://developers.facebook.com/apps/
WHATSAPP_TOKEN=your-permanent-token
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=dukani-webhook-verify-2024

# ─── WhatsApp (Twilio — alternative) ──────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── App ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://dukani.ma
NEXT_PUBLIC_APP_NAME=Dukani

# ─── Email (Resend) ───────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@dukani.ma

# ─── Payments (Stripe) ────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
